<?xml version="1.0" encoding="utf-8"?>
<!-- Pane: an app opened with the turnstile slides in from the right, like the next page. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <translate android:fromXDelta="18%p" android:toXDelta="0" android:duration="240" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="200" />
</set>
